# Root gitignore for Lefermier

# OS & Editor files
.DS_Store
Thumbs.db
*.tmp
.idea/
.vscode/
*.swp
*.swo

# Web (Next.js / Node)
web/node_modules/
web/.next/
web/out/
web/build/
web/.env*.local
web/.vercel/
web/*.tsbuildinfo

# Admin (Next.js / Node)
admin/node_modules/
admin/.next/
admin/out/
admin/build/
admin/.env*.local
admin/.vercel/
admin/*.tsbuildinfo

# Landing (Next.js / Node)
landing/node_modules/
landing/.next/
landing/out/
landing/build/
landing/.env*.local
landing/.vercel/
landing/*.tsbuildinfo

# API (Symfony / PHP)
api/vendor/
api/var/
api/.env.local
api/.env.local.php
api/.env.*.local
api/config/jwt/*.pem
api/public/bundles/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
